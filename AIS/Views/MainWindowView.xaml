<ui:FluentWindow x:Class="AIS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AIS"
        xmlns:vm="clr-namespace:AIS.ViewModels"
        mc:Ignorable="d"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Default"
        Title="MainWindow" Height="600" Width="1000">
    <ui:FluentWindow.DataContext>
        <vm:MainWindowViewModel />
    </ui:FluentWindow.DataContext>
    <Grid>
        <ui:TitleBar Icon="{DynamicResource Icon}" x:Name="TitleBar" Padding="30,0,0,0"/>
        <ui:NavigationView IsBackButtonVisible="Auto"
                           MenuItemsSource="{Binding ModuleItemsNav}"
                           TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
                           FooterMenuItemsSource="{Binding FooterModuleItemsNav, Mode=OneWay}"
                           Padding="42,21,42,21"
                           OpenPaneLength="270"
                           >
        </ui:NavigationView>

