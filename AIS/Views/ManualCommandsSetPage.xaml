<UserControl x:Class="AIS.Views.ManualCommandsSetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="White">
    <Border BorderBrush="#E0E0E0" BorderThickness="1" 
            Background="White" CornerRadius="5" Padding="15">
        <StackPanel>
            <!-- Заголовок -->
            <TextBlock Text="Управление исполнительными устройствами"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Выбор устройства -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Исполнительное устройство:" 
                           FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          Height="35" Width="300"
                          HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding GreenhouseName}" 
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Type}" 
                                           Foreground="Gray" 
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Регулировка мощности -->
            <StackPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Мощность: " FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PowerValue, StringFormat='{}{0}%'}" 
                               Foreground="#0078D7" FontWeight="Bold"/>
                </StackPanel>

                <!-- Slider для регулировки -->
                <Slider Minimum="-100" Maximum="100" 
                        Value="{Binding PowerValue}"
                        TickFrequency="10" TickPlacement="BottomRight"
                        Height="30" Width="300"
                        HorizontalAlignment="Left"/>

            </StackPanel>

            <!-- Кнопка применения -->
            <ui:Button Content="Применить" 
                    HorizontalAlignment="Left"
                    Width="120" Height="35"
                    FontWeight="Bold"
                    Padding="10,5"
                    Command="{Binding ApplyCommand}"/>
        </StackPanel>
    </Border>
</UserControl>