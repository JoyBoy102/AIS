<UserControl x:Class="AIS.Views.ManualCommandsSetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:vm="clr-namespace:AIS.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ManualCommandsSetPageViewModel}"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Управление исполнительными устройствами"
                   FontSize="16" FontWeight="Bold" 
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Margin="0,0,0,10"/>

        <!-- Выбор теплицы -->
        <TextBlock Text="Теплица:" 
                   FontWeight="SemiBold" 
                   VerticalAlignment="Center"
                   Margin="0,15,10,15"
                   Grid.Row="1" Grid.Column="0"/>

        <ComboBox ItemsSource="{Binding Greenhouses}"
                  SelectedItem="{Binding SelectedGreenhouse}"
                  Margin="0,15,10,15"
                  Grid.Row="1" Grid.Column="1"/>

        <!-- Выбор устройства -->
        <TextBlock Text="Устройство:" 
                   FontWeight="SemiBold" 
                   VerticalAlignment="Center"
                   Visibility="{Binding SelectedGreenhouse, Converter={StaticResource ObjToVis}}"
                   Grid.Row="2" Grid.Column="0"
                   Margin="0,15,10,15"/>

        <ComboBox ItemsSource="{Binding Devices}"
                  SelectedItem="{Binding SelectedDevice}"
                  Visibility="{Binding SelectedGreenhouse, Converter={StaticResource ObjToVis}}"
                  Grid.Row="2" Grid.Column="1"
                  Margin="0,15,10,15">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <ui:TextBlock Text="{Binding ., Converter={StaticResource EngToRus}}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Регулировка мощности -->
        <TextBlock Text="Мощность: " 
                   FontWeight="SemiBold"
                   Grid.Row="3" Grid.Column="0"
                   Visibility="{Binding SelectedDevice, Converter={StaticResource ObjToVis}}"
                   VerticalAlignment="Center"
                   Margin="0,15,10,5"/>

        <TextBlock Text="{Binding PowerValue, StringFormat='{}{0}%'}" 
                   Foreground="#0078D7" 
                   FontWeight="Bold"
                   Visibility="{Binding SelectedDevice, Converter={StaticResource ObjToVis}}"
                   Grid.Row="3" Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="0,15,10,5"/>

        <!-- Slider для регулировки -->
        <Slider Minimum="-100" 
                Maximum="100" 
                Value="{Binding PowerValue}"
                Visibility="{Binding SelectedDevice, Converter={StaticResource ObjToVis}}"
                TickFrequency="10" 
                TickPlacement="BottomRight"
                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Margin="0,5,10,15"/>

        <!-- Кнопка применения -->
        <ui:Button Content="Применить" 
                   Margin="0,15,10,15"
                   Appearance="Primary"
                   FontWeight="Bold"
                   Visibility="{Binding SelectedDevice, Converter={StaticResource ObjToVis}}"
                   Command="{Binding ApplyCommand}"
                   Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   HorizontalAlignment="Stretch"/>
    </Grid>
</UserControl>