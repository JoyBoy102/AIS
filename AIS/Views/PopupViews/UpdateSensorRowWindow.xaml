<ui:FluentWindow x:Class="AIS.Views.UpdateSensorRowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:AIS.Views"
        xmlns:conv="clr-namespace:AIS.Converters" 
        xmlns:popupviewmodels="clr-namespace:AIS.ViewModels.PopupViewModels"
        mc:Ignorable="d"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Default"
        Title="Редактирование датчика" 
        MinHeight="450" MaxHeight="450" 
        MaxWidth="400" MinWidth="400"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=popupviewmodels:UpdateSensorRowWindowViewmodel}">

    <Window.Resources>
        <conv:MinusOneConverter x:Key="MinusOneConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Icon="{DynamicResource Icon}" x:Name="TitleBar"/>

        <Grid Margin="20" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                       Text="Редактирование данных датчика" 
                       FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ID датчика -->
            <TextBlock Grid.Row="1" Grid.Column="0" 
                       Text="ID датчика:" 
                       VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ui:TextBox Grid.Row="1" Grid.Column="1" 
                        Text="{Binding SensorID, Mode=OneWay}"
                        IsReadOnly="True"
                        Margin="0,0,0,10"/>

            <!-- Тип датчика -->
            <TextBlock Grid.Row="2" Grid.Column="0" 
                       Text="Тип датчика:" 
                       VerticalAlignment="Center" Margin="0,0,10,10"/>
            <ui:TextBox Grid.Row="2" Grid.Column="1" 
                        Text="{Binding SensorType}"
                        Margin="0,0,0,10"
                        MaxLength="100"/>

            <!-- Теплица -->
            <TextBlock Grid.Row="3" Grid.Column="0" 
                       Text="Теплица:" 
                       VerticalAlignment="Top" Margin="0,10,10,10"/>
            <ComboBox Grid.Row="3" Grid.Column="1" 
                      x:Name="ComboBox"
                      VerticalAlignment="Top"
                      ItemsSource="{Binding Greenhouses}"
                      Margin="0,0,0,10"
                      SelectedIndex="{Binding SelectedGreenhouse.ID, Converter={StaticResource MinusOneConverter}}"
                      SelectedItem="{Binding SelectedGreenhouse}"/>

            <!-- Кнопки -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,20,0,0">
                <ui:Button Content="Сохранить" 
                          Height="30" 
                          Margin="0,0,10,0"
                          Appearance="Success"
                          Command="{Binding DataContext.UpdateSensorRowCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"/>

                <ui:Button Content="Отмена" 
                          Height="30"
                          Margin="0,0,10,0"
                          Appearance="Danger"
                          Command="{Binding DataContext.CloseWindowCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>