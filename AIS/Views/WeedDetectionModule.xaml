<UserControl x:Class="AIS.Views.WeedDetectionModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views"
             xmlns:vm="clr-namespace:AIS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:WeedDetectionViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Padding="15" BorderThickness="1" CornerRadius="16" BorderBrush="Black" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border BorderThickness="1" CornerRadius="8" Padding="15,8" Margin="5,0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Всего сорняков:" FontWeight="SemiBold" Foreground="#2E7D32"/>
                        <TextBlock FontSize="16" FontWeight="Bold" 
                                       Foreground="#1B5E20" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="8" Padding="15,8" Margin="5,0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Критические зоны:" FontWeight="SemiBold" Foreground="#C62828"/>
                        <TextBlock FontSize="16" FontWeight="Bold" 
                       Foreground="#1B5E20" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="8" Padding="15,8" Margin="5,0" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Уровень засоренности:" FontWeight="SemiBold" Foreground="#1565C0"/>
                        <TextBlock FontSize="16" FontWeight="Bold" 
                       Foreground="#1B5E20" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ItemsControl Grid.Row="1" Margin="5" ItemsSource="{Binding DetectionImages}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"></WrapPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#CCC" BorderThickness="1" Margin="5" Background="White">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Width="200" Height="150" Stretch="UniformToFill"/>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding GreenhouseName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DetectionTime}" FontSize="10"/>
                                <TextBlock Text="{Binding Confidence}" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>