<UserControl x:Class="AIS.Views.WeedDetectionModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views"
             xmlns:vm="clr-namespace:AIS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" d:DataContext="{d:DesignInstance Type=vm:WeedDetectionViewModel}">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.333*"></ColumnDefinition>
                <ColumnDefinition Width="0.333*"></ColumnDefinition>
                <ColumnDefinition Width="0.333*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Всего сорняков:" FontTypography="Subtitle"/>
                <ui:TextBlock FontTypography="Subtitle"
                              Margin="8,0,0,0"
                              Text="{Binding TotalWeedsCount}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Критические зоны:" FontTypography="Subtitle"/>
                <ui:TextBlock FontTypography="Subtitle" Margin="8,0,0,0" Text="{Binding CriticalZonesCount}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:TextBlock Text="Уровень засоренности:" FontTypography="Subtitle"/>
                <ui:TextBlock FontTypography="Subtitle" Margin="8,0,0,0" Text="{Binding WeedLevel}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="3" Visibility="{Binding IsLoading}" Background="White" Panel.ZIndex="999">
            <ui:LoadingScreen>
                <ui:LoadingScreen.Content>
                    <ui:TextBlock Text="Подождите, идет загрузка фотографий..." Margin="-140,0,0,0" FontTypography="Subtitle"/>
                </ui:LoadingScreen.Content>
            </ui:LoadingScreen>
        </Border>

        <ScrollViewer Grid.Row="1" Visibility="{Binding Loaded}">
            <ItemsControl Margin="5" ItemsSource="{Binding DetectionImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCC" BorderThickness="1" Margin="5" Background="White">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" 
                                            Command="{Binding DataContext.OpenImagePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Image Source="{Binding ImagePath}" 
                                       Width="200" 
                                       Height="150" 
                                       Stretch="UniformToFill"/>

                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding GreenhouseName}" 
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DetectionTime}" 
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding Confidence, StringFormat='Точность: {0}'}" 
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <ui:Button Grid.Row="2"
                Content="Загрузить фотографии с камер"
                Margin="7"
                HorizontalAlignment="Center"
                Visibility="{Binding IsButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Command="{Binding LoadImagesCommand}">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" 
                   FontSize="20"/>
            </ui:Button.Icon>
        </ui:Button>

    </Grid>
</UserControl>