<UserControl x:Class="AIS.Views.WeedDetectionModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views"
             xmlns:vm="clr-namespace:AIS.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Border Padding="15" BorderThickness="1" CornerRadius="16" BorderBrush="Black">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                    <ColumnDefinition Width="0.333*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border BorderThickness="1" CornerRadius="8" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Всего сорняков:" FontWeight="SemiBold" Foreground="#2E7D32" FontSize="14"/>
                        <TextBlock FontSize="14" FontWeight="Bold" 
                                   Foreground="#2E7D32" Margin="8,0,0,0"
                                   Text="{Binding TotalWeedsCount}"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="8" Grid.Column="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Критические зоны:" FontWeight="SemiBold" Foreground="#C62828" FontSize="14"/>
                        <TextBlock FontSize="14" FontWeight="Bold" 
                       Foreground="#C62828" Margin="8,0,0,0" Text="{Binding CriticalZonesCount}"/>
                    </StackPanel>
                </Border>
                <Border BorderThickness="1" CornerRadius="8" Grid.Column="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Уровень засоренности:" FontWeight="SemiBold" Foreground="#1565C0" FontSize="14"/>
                        <TextBlock FontSize="14" FontWeight="Bold" 
                       Foreground="#1565C0" Margin="8,0,0,0" Text="{Binding WeedLevel}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Visibility="{Binding IsLoading}" Background="White">
            <TextBlock Text="Подождите, идет загрузка фотографий..." FontSize="32" VerticalAlignment="Center" HorizontalAlignment="Center"></TextBlock>
        </Border>
        
        <ScrollViewer Grid.Row="1" Visibility="{Binding Loaded}">
            <ItemsControl Margin="5" ItemsSource="{Binding DetectionImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"></WrapPanel>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#CCC" BorderThickness="1" Margin="5" Background="White">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" 
                                            Command="{Binding DataContext.OpenImagePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <StackPanel>
                                <Image Source="{Binding ImagePath}" 
                                       Width="200" 
                                       Height="150" 
                                       Stretch="UniformToFill"/>

                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding GreenhouseName}" 
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DetectionTime}" 
                                               FontSize="10"/>
                                    <TextBlock Text="{Binding Confidence, StringFormat='Точность: {0}'}" 
                                               FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>


    </Grid>
</UserControl>