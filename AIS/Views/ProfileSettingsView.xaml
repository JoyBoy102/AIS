<UserControl x:Class="AIS.Views.ProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views" xmlns:viewmodels="clr-namespace:AIS.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ProfileSettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel Margin="0,0,0,24">
        <ui:TextBlock
            Margin="0,0,0,8"
            FontTypography="BodyStrong"
            Text="Настройки профиля" /> 
        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Mail24}">
            <ui:CardControl.Header>
                <ui:TextBlock
                        Grid.Row="0"
                        FontTypography="Body"
                        Text="Адрес электронной почты" />
            </ui:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentUserEmail}" Margin="5"></TextBlock>
                <ui:Button Grid.Column="1" Appearance="Secondary"
                            ToolTip="Редактировать">
                    <ui:SymbolIcon Symbol="Edit24"
                                   Width="16"
                                   Height="16"
                                   Foreground="#666"/>
                </ui:Button>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Phone24}">
            <ui:CardControl.Header>
                <ui:TextBlock
                Grid.Row="0"
                FontTypography="Body"
                Text="Номер телефона" />
            </ui:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentUserNumber}" Margin="5"></TextBlock>
                <ui:Button Grid.Column="1" Appearance="Secondary"
                           ToolTip="Редактировать">
                    <ui:SymbolIcon Symbol="Edit24"
                                   Width="16"
                                   Height="16"
                                   Foreground="#666"/>
                </ui:Button>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon LockClosed24}">
            <ui:CardControl.Header>
                <ui:TextBlock
                    Grid.Row="0"
                    FontTypography="Body"
                    Text="Пароль" />
            </ui:CardControl.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentUserPassword}" Margin="5"></TextBlock>
                <ui:Button Grid.Column="1" Appearance="Secondary"
                           ToolTip="Редактировать">
                    <ui:SymbolIcon Symbol="Edit24"
                                   Width="16"
                                   Height="16"
                                   Foreground="#666"/>
                </ui:Button>
            </Grid>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Certificate24}">
            <ui:CardControl.Header>
                <ui:TextBlock
                    Grid.Row="0"
                    FontTypography="Body"
                    Text="Статус лицензии" />
            </ui:CardControl.Header>
            <TextBlock Text="{Binding CurrentUserLicenseStatus}"></TextBlock>
        </ui:CardControl>
    </StackPanel>
</UserControl>
