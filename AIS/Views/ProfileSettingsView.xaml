<UserControl x:Class="AIS.Views.ProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AIS.Views" 
             xmlns:viewmodels="clr-namespace:AIS.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProfileSettingsViewModel}"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <ui:TextBlock
                    Margin="0,0,0,8"
                    FontTypography="Subtitle"
                    Text="Настройки профиля" />

                <!-- Email Card -->
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Mail24}" Visibility="{Binding EmailVisibility}">
                    <ui:CardControl.Header>
                        <ui:TextBlock
                            Margin="0,10"
                            FontTypography="Body"
                            Text="Адрес электронной почты" />
                    </ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Режим просмотра -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentUserEmail}" 
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEditingEmail, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>

                        <!-- Режим редактирования -->
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding EditedEmail, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Введите email"
                                    
                                    Visibility="{Binding IsEditingEmail, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Кнопка редактирования -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Редактировать"
                                      Command="{Binding EditEmailCommand}"
                                      Visibility="{Binding IsEditingEmail, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Edit24"
                                               FontSize="20"
                                               Foreground="#666"/>
                            </ui:Button>

                            <!-- Кнопка отмены -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Отменить"
                                      Command="{Binding CancelEmailCommand}"
                                      Visibility="{Binding IsEditingEmail, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Dismiss24"
                                               FontSize="20"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:CardControl>

                <!-- Phone Card -->
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Phone24}" Visibility="{Binding PhoneVisibility}">
                    <ui:CardControl.Header>
                        <ui:TextBlock
                            Margin="0,10"
                            FontTypography="Body"
                            Text="Номер телефона" />
                    </ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Режим просмотра -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentUserNumber}" 
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEditingPhone, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>

                        <!-- Режим редактирования -->
                        <ui:TextBox Grid.Column="0"
                                    Text="{Binding EditedPhone, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Введите номер телефона"
                                    ClearButtonEnabled="False"
                                    Visibility="{Binding IsEditingPhone, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Кнопка редактирования -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Редактировать"
                                      Command="{Binding EditPhoneCommand}"
                                      Visibility="{Binding IsEditingPhone, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Edit24"
                                               FontSize="20"
                                               Foreground="#666"/>
                            </ui:Button>

                            <!-- Кнопка отмены -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Отменить"
                                      Command="{Binding CancelPhoneCommand}"
                                      Visibility="{Binding IsEditingPhone, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Dismiss24"
                                               FontSize="20"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:CardControl>

                <!-- Password Card -->
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon LockClosed24}">
                    <ui:CardControl.Header>
                        <ui:TextBlock
                            Margin="0,10"
                            FontTypography="Body"
                            Text="Пароль" />
                    </ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Режим просмотра -->
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentUserPassword}" 
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsEditingPassword, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"/>

                        <!-- Режим редактирования -->
                        <ui:TextBox Grid.Column="0"
                                        MinWidth="200"
                                        ClearButtonEnabled="False"
                                        Text="{Binding EditedPassword, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Введите новый пароль"
                                        Visibility="{Binding IsEditingPassword, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Кнопка редактирования -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Редактировать"
                                      Command="{Binding EditPasswordCommand}"
                                      Visibility="{Binding IsEditingPassword, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=inverse}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Edit24"
                                               FontSize="20"
                                               Foreground="#666"/>
                            </ui:Button>

                            <!-- Кнопка отмены -->
                            <ui:Button Appearance="Secondary"
                                      ToolTip="Отменить"
                                      Command="{Binding CancelPasswordCommand}"
                                      Visibility="{Binding IsEditingPassword, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Margin="0,0,5,0">
                                <ui:SymbolIcon Symbol="Dismiss24"
                                               FontSize="20"/>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </ui:CardControl>

                <!-- License Card -->
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Shield24}">
                    <ui:CardControl.Header>
                        <ui:TextBlock
                            FontTypography="Body"
                            FontSize="14"
                            Text="Администратор" />
                    </ui:CardControl.Header>
                    <TextBlock Text="{Binding CurrentUserAdministratorStatus}"></TextBlock>
                </ui:CardControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка Сохранить -->
        <ui:Button Grid.Row="0" 
                   Content="Сохранить изменения" 
                   HorizontalAlignment="Stretch" 
                   VerticalAlignment="Bottom"
                   Command="{Binding Save}"
                   Visibility="{Binding SaveButtonVisibility}"
                   Margin="0,10,0,0">
            <ui:Button.Icon>
                <ui:SymbolIcon Symbol="Save20" 
                               FontSize="20"/>
            </ui:Button.Icon>
        </ui:Button>
    </Grid>
</UserControl>