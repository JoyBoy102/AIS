<Application x:Class="AIS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIS"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="Views/MainWindowView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ControlsDictionary />
                <ResourceDictionary Source="/Wpf.Ui;component/Controls/ListBox/ListBoxItem.xaml"/>
                <ui:ThemesDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="ApplicationBackgroundColor">#FFFAFAFA</Color>
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />
            <ui:ImageIcon x:Key="Icon" 
                          Source="/Resources/icon_black.png" 
                          x:Shared="False"
                          Margin="-7,-7,0,0"/>
            <ui:ImageIcon x:Key="IconBlack" 
                          Source="/Resources/icon_black.png" 
                          Margin="-7,-7,0,0"/>
            <ui:ImageIcon x:Key="IconWhite" 
                          Source="/Resources/icon_white.png" 
                          Margin="-7,-7,0,0"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>